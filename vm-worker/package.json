{
  "name": "siplan-hub-vm-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Worker da VM Linux: processa jobs do Supabase, executa a skill de modelos pelo Codex e devolve o JSON ao SiplanHUB.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test src/runSkill.test.ts src/sdTimeImport.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare:ellevo-hours-view": "node scripts/prepare-ellevo-hours-view.mjs"
  },
  "dependencies": {
    "@openai/codex": "0.147.0",
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^16.4.5",
    "mssql": "^12.7.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
