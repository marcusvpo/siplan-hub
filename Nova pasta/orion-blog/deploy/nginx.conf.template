# HTTPS é encerrado no proxy do sistema principal. Não publique esta porta em HTTP na internet.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    root /srv/orion;
    client_max_body_size 6m;
    try_files $uri =404;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    location = /healthz { access_log off; return 200 'ok'; }
    __MOUNT_REDIRECT__

    # O backend mantém /api/v1 interno; somente este proxy remove o prefixo público.
    location ^~ __BLOG_BASE_PATH__api/ {
        proxy_pass http://api:3333/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
        proxy_read_timeout 60s;
    }
    location ~ /\. { deny all; }
    location __BLOG_BASE_PATH__assets/ { try_files $uri =404; }
    location __BLOG_BASE_PATH__ {
        # HTML nunca fica preso no cache após trocar os arquivos versionados do build.
        expires -1;
        try_files $uri __BLOG_BASE_PATH__index.html;
    }
}
