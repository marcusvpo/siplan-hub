# Copie para deploy/.env SOMENTE na infraestrutura de destino. Nunca versione o arquivo real.
RELEASE_TAG=local
APP_ORIGIN=https://sistema.example.com
BLOG_BASE_PATH=/blog/
BLOG_HTTP_PORT=8080
# Gere no destino: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=
# Runtime sem superuser, CREATEDB, CREATEROLE, BYPASSRLS ou permissão de alterar estrutura.
# Encode os caracteres especiais da senha na URL. Produção exige TLS validado.
DATABASE_URL=
# Credencial de migração é separada e utilizada apenas pelo serviço migrate.
MIGRATION_DATABASE_URL=
# Configure os IPs/CIDRs EXATOS dos proxies da implantação. Vazio não confia nos headers.
TRUST_PROXY_CIDRS=
