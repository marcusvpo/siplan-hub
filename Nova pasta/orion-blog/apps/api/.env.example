NODE_ENV=development
PORT=3333
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orion_central
APP_ORIGIN=http://localhost:5173
BLOG_BASE_PATH=/
# Vazio mantém trustProxy=false. Em produção, informe apenas proxies conhecidos.
TRUST_PROXY_CIDRS=
COOKIE_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
# local: login próprio. host: sessão/permissão fornecida pelo adaptador do sistema maior.
# No modo host, implemente src/auth/host-adapter.ts; sem adaptador válido o acesso é negado.
ADMIN_AUTH_MODE=local
# Necessários somente no modo local:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$gere-um-hash-scrypt-antes-de-produzir
ADMIN_SESSION_DAYS=1
